---
// The public "what shipped" surface. It renders the repository's tracked
// CHANGELOG.md directly so the site never carries a second, drifting copy;
// the file is compiled at release time (see RELEASING.md), so this page only
// ever describes released behavior. The build stays a pure function of tracked
// sources — the import is resolved at build time, nothing is fetched.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Content as ChangelogContent, getHeadings } from '../../../CHANGELOG.md';

// The changelog's own H1 ("Changelog") duplicates the page title; the release
// sections underneath it are the useful table of contents.
const headings = getHeadings().filter((heading) => heading.depth === 2).map((heading) => ({
  ...heading,
  text: heading.text.match(/^\d+\.\d+\.\d+/)?.[0] ?? heading.text,
}));
---

<StarlightPage
  frontmatter={{
    title: 'Changelog',
    description: 'Every released Orbit version, newest first, with breaking changes and highlights.',
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
  headings={headings}
>
  <p>
    What changed in each Orbit release, newest first. Breaking changes come before highlights.
    Follow a pull request link to find the delivery on GitHub. The newest three releases are
    expanded; select an older version to read its notes.
  </p>
  <div class="orbit-changelog-upgrade">
    <span>Check for a newer release:</span>
    <code>orbit update --check</code>
    <span>New here? <a href="/getting-started/install/">Install Orbit</a>.</span>
  </div>
  <div class="orbit-changelog">
    <ChangelogContent />
  </div>
</StarlightPage>

<script>
  // Version and subsection links retain their original IDs. Reveal a folded
  // body before scrolling, both on a direct URL and later hash navigation.
  function revealRelease() {
    let id: string;
    try {
      id = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    const release = target?.closest<HTMLDetailsElement>('.orbit-release');
    if (!target || !release) return;
    release.open = true;
    requestAnimationFrame(() => target.scrollIntoView());
  }
  revealRelease();
  window.addEventListener('hashchange', revealRelease);
</script>
