---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { latestRelease } from './latestRelease';
import { navLinks as links } from './navLinks';

const pathname = Astro.url.pathname;
---

<Default />
{
  latestRelease && (
    <a class="orbit-version print:hidden" href="/changelog/" aria-label={`v${latestRelease} release notes`}>
      v{latestRelease}
    </a>
  )
}

<nav class="orbit-topnav print:hidden" aria-label="Documentation sections">
  {
    links.map(({ href, label }) => (
      <a href={href} aria-current={pathname.startsWith(href) ? 'true' : undefined}>
        {label}
      </a>
    ))
  }
</nav>
