---
import Default from '@astrojs/starlight/components/Footer.astro';

// The splash homepage has no pagination, edit link or last-updated line, so
// Starlight's footer would only add empty space above ours.
const { hasSidebar } = Astro.locals.starlightRoute;

const links = [
  { href: 'https://github.com/constellation-works/orbit', label: 'GitHub' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/contributing/', label: 'Contributing' },
  { href: '/privacy/', label: 'Privacy' },
];
---

{hasSidebar && <Default><slot /></Default>}

<footer class="orbit-footer">
  <p>Orbit is MIT licensed and sends no telemetry.</p>
  <nav class="orbit-footer-nav" aria-label="Footer">
    {links.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>
</footer>
