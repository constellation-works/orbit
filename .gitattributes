# Check text out with LF on every platform, whatever core.autocrlf says.
# Goldens and include_str!/include_bytes! assets must have identical bytes on
# Windows, and shell scripts and hooks cannot run with CRLF line endings.
* text=auto eol=lf

# Tracked binary assets and raw detached signatures: never normalised or
# diffed as text.
*.gif binary
*.png binary
*.sig binary
*.woff2 binary
*.whl binary
