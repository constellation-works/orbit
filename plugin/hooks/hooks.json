{
  "description": "Check for an Orbit workspace at session start and link task and run IDs in assistant replies.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-workspace.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modules": [
    "./mod/register.ts"
  ]
}
