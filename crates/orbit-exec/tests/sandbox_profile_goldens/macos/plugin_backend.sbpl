;; provider: plugin
(version 1)
(deny default)
(allow file-read*)
(allow process*)
(allow signal)
(allow ipc-posix*)
(allow mach*)
(allow system-fsctl)
(allow system-socket)
(allow system-mac-syscall (mac-policy-name "vnguard"))
(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow network*)
(allow sysctl*)
(allow iokit*)
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* (require-all (regex #"^/dev/ttys[0-9]+") (extension "com.apple.sandbox.pty")))
(allow file-ioctl (regex #"^/dev/ttys[0-9]+"))
(allow file-write* (subpath "/tmp"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/private/var/folders"))
(allow file-write* (subpath "/dev"))
(allow file-write* (subpath "<HOME>/Library/Caches"))
(allow file-write* (subpath "<HOME>/.orbit/state/logs"))
(allow file-write* (subpath "<HOME>/.cargo/registry"))
(allow file-write* (subpath "<HOME>/.cargo/git"))
(allow file-write* (literal "<HOME>/.cargo/.package-cache"))
(allow file-write* (literal "<HOME>/.cargo/.package-cache-mutate"))
(allow file-write* (subpath "<HOME>/.codex"))
(allow file-write* (subpath "<HOME>/.claude"))
(allow file-write* (subpath "<HOME>/.gemini"))
(allow file-write* (subpath "<HOME>/.grok"))
(allow file-write* (literal "<HOME>/.claude.json"))
(allow file-write* (literal "<HOME>/.claude.json.lock"))
(allow file-write* (regex "^<HOME>/\\.claude\\.json\\.tmp\\.[0-9]+\\.[0-9]+$"))
(allow file-write* (literal "<HOME>/.grok/auth.json"))
(allow file-write* (literal "<HOME>/.grok/auth.json.lock"))
(allow file-write* (regex "^<HOME>/\\.grok/auth\\.json\\.tmp(?:\\.[0-9]+)*$"))
(allow file-write* (literal "<HOME>/.grok/mcp_credentials.json"))
(allow file-write* (literal "<HOME>/.grok/mcp_credentials.json.lock"))
(allow file-write* (regex "^<HOME>/\\.grok/mcp_credentials\\.json\\.tmp(?:\\.[0-9]+)*$"))
(allow file-write* (literal "<HOME>/.grok/models_cache.json"))
(allow file-write* (literal "<HOME>/.grok/models_cache.json.lock"))
(allow file-write* (regex "^<HOME>/\\.grok/models_cache\\.json\\.tmp(?:\\.[0-9]+)*$"))
(allow file-write* (regex "^<HOME>/\\.grok/mcp_auth_[^/]+\\.lock$"))
(allow file-write* (subpath "<HOME>/.orbit/state/plugins/demo"))
(deny file-read* (subpath "<HOME>/.ssh"))
(deny file-read* (subpath "<HOME>/.aws"))
(deny file-read* (subpath "<HOME>/.config/gh"))
(deny file-read* (subpath "<HOME>/Library/Keychains"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Google/Chrome"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Chromium"))
(deny file-read* (subpath "<HOME>/Library/Application Support/BraveSoftware/Brave-Browser"))
(deny file-read* (subpath "<HOME>/Library/Application Support/Firefox"))
(deny file-read* (literal "<HOME>/.cargo/credentials"))
(deny file-read* (literal "<HOME>/.cargo/credentials.toml"))
(deny file-read* (subpath "/Library/Keychains"))
(deny file-read* (subpath "/System/Library/Keychains"))
(deny file-read* (subpath "<HOME>/.orbit/state/plugin-callbacks"))
(deny file-read* (subpath "<HOME>/.orbit/plugins/.grants"))
(deny file-read* (subpath "<HOME>/.orbit/state/plugins"))
(deny file-read* (subpath "<HOME>/.orbit/state/plugin-secrets"))
(allow file-read-metadata (literal "<HOME>/.orbit/state/plugins"))
(allow file-read* (subpath "<HOME>/.orbit/state/plugins/demo"))
(deny network*)
