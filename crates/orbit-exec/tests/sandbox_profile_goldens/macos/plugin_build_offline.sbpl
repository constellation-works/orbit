(version 1)
(deny default)
(allow file-read-metadata)
(allow process-fork)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow system-mac-syscall (mac-policy-name "vnguard"))
(allow system-mac-syscall (require-all (mac-policy-name "Sandbox") (mac-syscall-number 67)))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow file-read* (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone") (subpath "/private/etc/ssl") (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/etc/services") (literal "/private/etc/protocols") (literal "/private/etc/passwd") (literal "/private/etc/group") (literal "/private/etc/localtime") (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty") (literal "/dev/dtracehelper") (subpath "<HOME>/.cargo/bin/cargo") (subpath "<HOME>/.rustup/toolchains/stable-golden") (subpath "<HOME>/.rustup/settings.toml") (subpath "<HOME>/.orbit/plugins/demo/.build-golden"))
(allow process-exec (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library/Apple") (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone") (subpath "/private/etc/ssl") (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf") (literal "/private/etc/services") (literal "/private/etc/protocols") (literal "/private/etc/passwd") (literal "/private/etc/group") (literal "/private/etc/localtime") (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty") (literal "/dev/dtracehelper") (subpath "<HOME>/.cargo/bin/cargo") (subpath "<HOME>/.rustup/toolchains/stable-golden") (subpath "<HOME>/.rustup/settings.toml") (subpath "<HOME>/.orbit/plugins/demo/.build-golden"))
(allow file-write* (subpath "<HOME>/.orbit/plugins/demo/.build-golden"))
(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))
(deny file-read* file-write* (subpath "<HOME>/.ssh"))
(deny file-read* file-write* (subpath "<HOME>/.aws"))
(deny file-read* file-write* (subpath "<HOME>/.config/gh"))
(deny file-read* file-write* (subpath "<HOME>/Library/Keychains"))
(deny file-read* file-write* (subpath "<HOME>/Library/Application Support/Google/Chrome"))
(deny file-read* file-write* (subpath "<HOME>/Library/Application Support/Chromium"))
(deny file-read* file-write* (subpath "<HOME>/Library/Application Support/BraveSoftware/Brave-Browser"))
(deny file-read* file-write* (subpath "<HOME>/Library/Application Support/Firefox"))
(deny file-read* file-write* (literal "<HOME>/.cargo/credentials"))
(deny file-read* file-write* (literal "<HOME>/.cargo/credentials.toml"))
(deny file-read* file-write* (subpath "/Library/Keychains"))
(deny file-read* file-write* (subpath "/System/Library/Keychains"))
(deny network*)
