        },
        "orchestrator": {
          "type": "string",
          "description": "Orchestrator crew; empty clears it."
        },
        "origin": {
          "type": "string",
          "description": "Why the task was filed."
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "New context selectors."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Accept selectors for created files."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Response field names."
        },
        "field": {
          "type": "string",
          "description": "One response field."
        },
        "request_id": {
          "type": "string",
          "description": "Retry-safe write identity."
        },
        "expected_revision": {
          "type": "string",
          "description": "Revision from task show."
        },
        "verdict": {
          "type": "object",
          "description": "Review verdict object."
        },
        "complete": {
          "type": "boolean",
          "description": "Complete an accepted review."
