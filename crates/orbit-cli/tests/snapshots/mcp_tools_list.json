[
  {
    "name": "orbit_attention",
    "description": "List operator waits and suggested next actions. Details: installed Orbit skill `references/attention-reading.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace selector from orbit_workspace_list."
        },
        "all": {
          "type": "boolean",
          "description": "All active workspaces."
        },
        "host": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host names or IDs."
        },
        "kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled",
              "routine_tripped",
              "drain_paused",
              "drain_breaker_open"
            ]
          },
          "description": "Include kinds."
        },
        "exclude_kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled",
              "routine_tripped",
              "drain_paused",
              "drain_breaker_open"
            ]
          },
          "description": "Exclude kinds."
        },
        "severity": {
          "type": "string",
          "description": "Min severity.",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task statuses."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task tags."
        },
        "task": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task IDs."
        },
        "crew": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Assigned crews."
        },
        "orchestrator": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Orchestrators."
        },
        "older_than": {
          "type": "string",
          "description": "Min age (e.g. 90m, 36h, 3d)."
        },
        "since": {
          "type": "string",
          "description": "Prior response cursor."
        },
        "limit": {
          "type": "integer",
          "description": "Limit 1-500 (default 100).",
          "minimum": 1,
          "maximum": 500
        },
        "wait_grant": {
          "type": "boolean",
          "description": "Mint `orbit attention wait` token."
        },
        "candidate_read": {
          "type": "boolean",
          "description": "Internal aggregator flag; omit."
        }
      },
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_friction",
    "description": "Record a friction, or update one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (required fields): add (body); update (id).",
          "enum": [
            "add",
            "update"
          ]
        },
        "body": {
          "type": "string",
          "description": "add: Markdown friction description; update: Replacement markdown body."
        },
        "title": {
          "type": "string",
          "description": "add: One-line handle (<=120 chars; derived from body if omitted); update: Replacement title (<=120 chars; empty restores derivation).",
          "maxLength": 120
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "automation",
              "build",
              "docs",
              "history-diverged",
              "lifecycle",
              "naming",
              "other",
              "policy",
              "skill-guidance",
              "tooling"
            ]
          },
          "description": "Friction taxonomy tags."
        },
        "during_task": {
          "type": "string",
          "description": "add: Task ID being worked on (unknown ID refused)."
        },
        "id": {
          "type": "string",
          "description": "update: Friction ID (FYYYY-MM-NNN)."
        },
        "status": {
          "type": "string",
          "description": "update: open, triaged, or resolved."
        },
        "rehome_to": {
          "type": "string",
          "description": "update: Owning workspace; moves record unless `move` is false (empty clears)."
        },
        "move": {
          "type": "boolean",
          "description": "update: With `rehome_to`: false records disposition without moving (default true)."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_search",
    "description": "Search tasks and frictions using lexical matching.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search terms (optional if `kind: friction`).",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "task, friction, or all (default: all)."
        },
        "limit": {
          "type": "integer",
          "description": "Max results, <=1000."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AND-filter by tag.",
          "minItems": 1
        },
        "all": {
          "type": "boolean",
          "description": "Include all statuses."
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Per-kind status tokens (e.g. `task:open`)."
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra workspace selectors to search."
        },
        "all_workspaces": {
          "type": "boolean",
          "description": "Search all active workspaces (not managed)."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "query"
              ]
            },
            {
              "required": [
                "tag"
              ]
            },
            {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "friction"
                }
              }
            }
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_add",
    "description": "Create a task and return its JSON; rules are in the installed Orbit skill `references/task-fields-*.md` references.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title."
        },
        "description": {
          "type": "string",
          "description": "Markdown body."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Criteria."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite task IDs."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags."
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Added baseline tool names."
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operator-granted tools."
        },
        "requires_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required host capability labels."
        },
        "not_before": {
          "type": "string",
          "description": "Earliest start (RFC 3339)."
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target `file:`/`dir:`/`symbol:` selectors."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Allow selectors for new files."
        },
        "priority": {
          "type": "string",
          "description": "low|medium|high|critical"
        },
        "complexity": {
          "type": "string",
          "description": "low|medium|hard|xhard"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "refactor",
            "chore"
          ],
          "description": "Kind."
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Typed relations."
        },
        "source_task_id": {
          "type": "string",
          "description": "Introducing bug source task ID."
        },
        "crew": {
          "type": [
            "string",
            "null"
          ],
          "description": "Execution crew."
        },
        "orchestrator": {
          "type": "string",
          "description": "Orchestrator crew."
        },
        "orchestrator_model": {
          "type": "string",
          "description": "Orchestrator model override."
        },
        "origin": {
          "type": "string",
          "description": "operator_request | orchestrator_initiative | automation"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keyed response fields."
        },
        "field": {
          "type": "string",
          "description": "Single response field."
        },
        "request_id": {
          "type": "string",
          "description": "Retry-safe creation identity; selects guarded creation, which accepts only 'title', 'description', 'acceptance_criteria', 'priority', 'crew'."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "request_id"
            ]
          },
          "then": {
            "required": [
              "workspace",
              "description",
              "acceptance_criteria"
            ],
            "propertyNames": {
              "enum": [
                "workspace",
                "request_id",
                "title",
                "description",
                "acceptance_criteria",
                "priority",
                "crew"
              ]
            },
            "properties": {
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "crew": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "else": {
            "required": [
              "description",
              "complexity"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_artifact",
    "description": "Read/attach artifacts; list via `orbit_task_show` (`fields: [\"artifacts\"]`).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (required fields): get (id, path); put (id, source_path).",
          "enum": [
            "get",
            "put"
          ]
        },
        "id": {
          "type": "string",
          "description": "Task ID."
        },
        "path": {
          "type": "string",
          "description": "get: Path from `orbit_task_show` (`field: \"artifacts\"`); put: Relative artifact path (default: source name; `review-*` reserved except `review-report.json`)."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "source_path": {
          "type": "string",
          "description": "put: Source file inside workspace (write evidence under `.orbit/tmp/`)."
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_eligible",
    "description": "List backlog and proposed tasks that can be picked up now without colliding with work in flight.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "backlog",
              "proposed"
            ]
          },
          "description": "Statuses (default: both)."
        },
        "path": {
          "type": "string",
          "description": "Match `context_files` path."
        },
        "limit": {
          "type": "integer",
          "description": "Max tasks (default 50, >=1)."
        },
        "explain": {
          "type": "boolean",
          "description": "Also return `conflicting`."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_list",
    "description": "List tasks as {tasks, total, truncated}; rules are in the installed Orbit skill `references/task-fields-projections.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Statuses."
        },
        "parent_id": {
          "type": "string",
          "description": "Parent ID."
        },
        "type": {
          "type": "string",
          "description": "Task type."
        },
        "scheduled": {
          "type": "boolean",
          "description": "Future schedules, soonest first."
        },
        "not_before_from": {
          "type": "string",
          "description": "Min `not_before` (RFC 3339)."
        },
        "not_before_until": {
          "type": "string",
          "description": "Max `not_before` (RFC 3339)."
        },
        "origin": {
          "type": "string",
          "description": "Origin."
        },
        "job_run_id": {
          "type": "string",
          "description": "Job run ID."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All tags must match."
        },
        "runs_on": {
          "type": "string",
          "description": "Host OS."
        },
        "pilot_warnings": {
          "type": "boolean",
          "description": "Only pilot-warned proposed."
        },
        "ready": {
          "type": "boolean",
          "description": "Only satisfied dependencies."
        },
        "path": {
          "type": "string",
          "description": "Matching context path."
        },
        "limit": {
          "type": "integer",
          "description": "Max tasks (default 50)."
        },
        "fields": {
          "type": "array",
