    "inputSchema": {
      "type": "object",
      "properties": {
        "repilot": {
          "type": "boolean",
          "description": "Request new pilot."
        },
        "id": {
          "type": "string",
          "description": "Task ID."
        },
        "title": {
          "type": "string",
          "description": "Title."
        },
        "description": {
          "type": "string",
          "description": "Empty clears."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces list."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces list."
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Replaces list."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces list."
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operator; replaces list."
        },
        "requires_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces list."
        },
        "not_before": {
          "type": "string",
