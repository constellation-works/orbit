        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "request_id"
