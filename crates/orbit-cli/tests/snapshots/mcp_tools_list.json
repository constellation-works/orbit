        "limit": {
          "type": "integer",
          "description": "Max results (default 50, >= 1)."
        },
        "explain": {
          "type": "boolean",
          "description": "Include `conflicting` held-back tasks."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
