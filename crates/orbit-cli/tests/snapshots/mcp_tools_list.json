            "blocked",
            "archived",
            "rejected"
          ],
          "description": "Target status."
        },
        "note": {
          "type": "string",
          "description": "Status change note."
        },
        "priority": {
          "type": "string",
          "description": "low|medium|high|critical"
        },
        "complexity": {
          "type": "string",
          "description": "low|medium|hard|xhard"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "refactor",
            "chore"
          ],
          "description": "Kind."
        },
        "source_task_id": {
          "type": "string",
          "description": "Origin bug; empty clears."
        },
        "planned_by": {
          "type": "string",
          "description": "Empty clears."
        },
        "implemented_by": {
          "type": "string",
          "description": "Empty clears."
        },
        "execution_summary": {
          "type": "string",
          "description": "Empty clears."
        },
        "comment": {
          "type": "string",
          "description": "Appends comment."
        },
        "pr_status": {
          "type": "string",
          "description": "approve|request-changes; empty clears."
        },
        "job_run_id": {
          "type": "string",
          "description": "Empty clears."
        },
        "crew": {
          "type": "string",
          "description": "Empty redraws."
        },
        "orchestrator": {
          "type": "string",
          "description": "Empty clears."
        },
        "origin": {
          "type": "string",
          "description": "operator_request|orchestrator_initiative|automation"
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Replaces list."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Allow missing context."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keyed fields."
        },
        "field": {
          "type": "string",
          "description": "Single field."
        },
        "request_id": {
          "type": "string",
          "description": "Selects guarded update ('verdict', 'complete'; 'comment'; 'status'); omit for ordinary update."
        },
        "expected_revision": {
          "type": "string",
          "description": "Snapshot rev."
        },
        "verdict": {
          "type": "object",
          "description": "Review verdict."
        },
        "complete": {
          "type": "boolean",
          "description": "Complete review."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "request_id"
                ]
              },
              {
                "required": [
                  "expected_revision"
                ]
              },
              {
                "required": [
                  "verdict"
                ]
              },
              {
                "required": [
                  "complete"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "workspace",
              "request_id",
              "expected_revision"
            ],
            "oneOf": [
              {
                "required": [
                  "verdict"
