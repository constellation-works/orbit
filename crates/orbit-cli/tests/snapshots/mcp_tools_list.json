[
  {
    "name": "orbit_attention",
    "description": "List operator waits and suggested next actions. Details: installed Orbit skill `references/attention.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "From orbit_workspace_list."
        },
        "all": {
          "type": "boolean",
          "description": "Read every active workspace on this host."
        },
        "host": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host name/ID (repeatable)."
        },
        "kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled",
              "routine_tripped",
              "drain_paused",
              "drain_breaker_open"
            ]
          },
          "description": "Include kinds."
        },
        "exclude_kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled",
              "routine_tripped",
              "drain_paused",
              "drain_breaker_open"
            ]
          },
          "description": "Exclude kinds."
        },
        "severity": {
          "type": "string",
          "description": "Min severity.",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Statuses."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags."
        },
        "task": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task IDs."
        },
        "crew": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Crews."
        },
        "orchestrator": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Orchestrators."
        },
        "older_than": {
          "type": "string",
          "description": "Min age (90m, 36h, 3d)."
        },
        "since": {
          "type": "string",
          "description": "Pagination cursor."
        },
        "limit": {
          "type": "integer",
          "description": "Max 1-500 (default 100).",
          "minimum": 1,
          "maximum": 500
        },
        "wait_grant": {
          "type": "boolean",
          "description": "Mint `orbit attention wait` token."
        },
        "candidate_read": {
          "type": "boolean",
          "description": "Internal; omit."
        }
      },
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_friction",
    "description": "Record a friction, or update one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (required): add (body); update (id).",
          "enum": [
            "add",
            "update"
          ]
        },
        "body": {
          "type": "string",
          "description": "add: Markdown body; update: Replacement body."
        },
        "title": {
          "type": "string",
          "description": "add: Handle (<= 120 chars, default from body); update: Replacement (<= 120 chars, empty resets).",
          "maxLength": 120
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "automation",
              "build",
              "docs",
              "history-diverged",
              "lifecycle",
              "naming",
              "other",
              "policy",
              "skill-guidance",
              "tooling"
            ]
          },
          "description": "Friction taxonomy tags."
        },
        "during_task": {
          "type": "string",
          "description": "add: Task ID (must exist)."
        },
        "id": {
          "type": "string",
          "description": "update: Friction ID (`FYYYY-MM-NNN`)."
        },
        "status": {
          "type": "string",
          "description": "update: open|triaged|resolved."
        },
        "rehome_to": {
          "type": "string",
          "description": "update: Target workspace unless `move: false`; empty clears."
        },
        "move": {
          "type": "boolean",
          "description": "update: With `rehome_to`: false avoids moving (default true)."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_search",
    "description": "Search tasks and frictions using lexical matching.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Lexical query (optional if `kind: friction`).",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "task|friction|all (default all)."
        },
        "limit": {
          "type": "integer",
          "description": "Max <=1000 (default 10; 1000 friction list)."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AND-filter tags.",
          "minItems": 1
        },
        "all": {
          "type": "boolean",
          "description": "Include closed statuses."
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Per-kind (`kind:value`, overrides `all`)."
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Federate name/`ws_*`/path (default bound)."
        },
        "all_workspaces": {
          "type": "boolean",
          "description": "All active workspaces (not in managed runs)."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "query"
              ]
            },
            {
              "required": [
                "tag"
              ]
            },
            {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "friction"
                }
              }
            }
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_add",
    "description": "Create a task and return its JSON; rules are in the installed Orbit skill `references/task-fields.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title."
        },
        "description": {
          "type": "string",
          "description": "Markdown."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Criteria."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags."
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Baseline activity tools."
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operator tools."
        },
        "requires_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host capability labels."
        },
        "not_before": {
          "type": "string",
          "description": "RFC 3339 earliest start."
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Context selectors."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Allow missing context."
        },
        "priority": {
          "type": "string",
          "description": "low|medium|high|critical"
        },
        "complexity": {
          "type": "string",
          "description": "low|medium|hard|xhard"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "refactor",
            "chore"
          ],
          "description": "Kind."
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Typed relations."
        },
        "source_task_id": {
          "type": "string",
          "description": "Origin bug ID."
        },
        "crew": {
          "type": [
            "string",
            "null"
          ],
          "description": "Crew."
        },
        "orchestrator": {
          "type": "string",
          "description": "Orchestrator."
        },
        "orchestrator_model": {
          "type": "string",
          "description": "Orchestrator model."
        },
        "origin": {
          "type": "string",
          "description": "operator_request|orchestrator_initiative|automation"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keyed fields."
        },
        "field": {
          "type": "string",
          "description": "Single field."
        },
        "request_id": {
          "type": "string",
          "description": "Selects guarded creation ('title', 'description', 'acceptance_criteria', 'priority', 'crew' only)."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "request_id"
            ]
          },
          "then": {
            "required": [
              "workspace",
              "description",
              "acceptance_criteria"
            ],
            "propertyNames": {
              "enum": [
                "workspace",
                "request_id",
                "title",
                "description",
                "acceptance_criteria",
                "priority",
                "crew"
              ]
            },
            "properties": {
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "crew": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "else": {
            "required": [
              "description",
              "complexity"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_artifact",
    "description": "Read/attach artifacts; list via `orbit_task_show` (`fields: [\"artifacts\"]`).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action (required): get (id, path); put (id, source_path).",
          "enum": [
            "get",
            "put"
          ]
        },
        "id": {
          "type": "string",
          "description": "Task ID."
        },
        "path": {
          "type": "string",
          "description": "get: Path from `orbit_task_show` (`field: \"artifacts\"`); put: Target path (default filename); `review-*` reserved except `review-report.json`."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        },
        "source_path": {
          "type": "string",
          "description": "put: Workspace file path (e.g. `.orbit/tmp/...`); escapes/`/tmp` rejected."
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_eligible",
    "description": "List backlog and proposed tasks that can be picked up now without colliding with work in flight.",
