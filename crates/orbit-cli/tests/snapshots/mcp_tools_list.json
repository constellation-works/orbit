        "title": {
          "type": "string",
          "description": "Title."
        },
        "description": {
          "type": "string",
          "description": "Body (empty clears)."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "New criteria."
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "New dependency IDs (empty clears)."
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
