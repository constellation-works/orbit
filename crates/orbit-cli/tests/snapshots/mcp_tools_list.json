          "description": "low|medium|high|critical"
        },
        "complexity": {
          "type": "string",
          "description": "low|medium|hard|xhard"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "refactor",
            "chore"
          ],
          "description": "Kind."
        },
        "source_task_id": {
          "type": "string",
