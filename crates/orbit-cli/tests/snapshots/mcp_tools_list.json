[
  {
    "name": "orbit_attention",
    "description": "List operator waits and suggested next actions. Details: installed Orbit skill `references/attention.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace selector from orbit_workspace_list."
        },
        "all": {
          "type": "boolean",
          "description": "Read every active workspace on this host."
        },
        "host": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host name or machine id (repeatable)."
        },
        "kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled"
            ]
          },
          "description": "Include kinds (repeatable)."
        },
        "exclude_kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pilot_warning",
              "pilot_hold",
              "blocked",
              "decision_open",
              "review_waiting",
              "run_failed",
              "run_stuck",
              "claim_stale",
              "ci_red",
              "friction_untriaged",
              "host_unhealthy",
              "notice_open",
              "resident_stalled"
            ]
          },
          "description": "Exclude kinds (repeatable)."
        },
        "severity": {
          "type": "string",
          "description": "Minimum severity: low, medium, high or critical.",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task lifecycle states (repeatable)."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task tags (repeatable)."
        },
        "task": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task ids (repeatable)."
        },
        "crew": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Assigned crews (repeatable)."
        },
        "orchestrator": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Attributed orchestrators (repeatable)."
        },
        "older_than": {
          "type": "string",
          "description": "Minimum age, such as 90m, 36h or 3d."
        },
        "since": {
          "type": "string",
          "description": "Opaque cursor from a prior response."
        },
        "limit": {
          "type": "integer",
          "description": "Public response limit, 1–500 (default 100).",
          "minimum": 1,
          "maximum": 500
        },
        "candidate_read": {
          "type": "boolean",
          "description": "Reserved for Orbit's federated aggregator."
        }
      },
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_friction",
    "description": "Record a friction, or update one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Operation to run, with its required fields: add (body); update (id).",
          "enum": [
            "add",
            "update"
          ]
        },
        "body": {
          "type": "string",
          "description": "For add: Markdown body describing what happened and why it caused friction; For update: Optional replacement markdown body."
        },
        "title": {
          "type": "string",
          "description": "For add: One-line handle identifying the problem, at most 120 characters; For update: Optional replacement one-line title, at most 120 characters; an empty string restores derivation from the body."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For add: Friction taxonomy tags as a string or array; valid tags: automation | build | docs | history-diverged | lifecycle | naming | other | policy | skill-guidance | tooling; defaults to other."
        },
        "during_task": {
          "type": "string",
          "description": "For add: Optional task ID being worked on when friction occurred; an ID that names no task is refused."
        },
        "id": {
          "type": "string",
          "description": "For update: Friction record ID, e.g. FYYYY-MM-NNN."
        },
        "status": {
          "type": "string",
          "description": "For update: Optional status: open, triaged, or resolved."
        },
        "rehome_to": {
          "type": "string",
          "description": "For update: Optional registered workspace that owns a friction recorded in the wrong one; moves the record there unless `move` is false."
        },
        "move": {
          "type": "boolean",
          "description": "For update: With `rehome_to`: false records the `rehome_required` disposition without moving, for a workspace that is not registered here; defaults to true."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_search",
    "description": "Search tasks and frictions using lexical matching.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Tasks match non-adjacent terms.",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "description": "Corpus kind: task, friction, or all."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of results, at most 1000."
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AND-filter by tag.",
          "minItems": 1
        },
        "all": {
          "type": "boolean",
          "description": "Include every status for the queried kind."
        },
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Explicit per-kind status override using kind."
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Federated scope."
        },
        "all_workspaces": {
          "type": "boolean",
          "description": "Search every active workspace registered on the answering machine."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "query"
              ]
            },
            {
              "required": [
                "tag"
              ]
            },
            {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "friction"
                }
              }
            }
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_add",
    "description": "Create a task and return its JSON; rules are in the installed Orbit skill `references/task-fields.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Task title."
        },
        "description": {
          "type": "string",
          "description": "Task description markdown."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Acceptance criteria."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task tags."
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Canonical tool names added to the activity baseline."
        },
        "granted_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Operator-granted tool names."
        },
        "requires_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Host capability labels the task requires."
        },
        "not_before": {
          "type": "string",
          "description": "Earliest dispatch time as an RFC 3339 instant."
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Context selectors this task will change."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Accept selectors for created files."
        },
        "priority": {
          "type": "string",
          "description": "low|medium|high|critical"
        },
        "complexity": {
          "type": "string",
          "description": "low|medium|hard|xhard"
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "refactor",
            "chore"
          ],
          "description": "Task type."
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Typed task relations."
        },
        "crew": {
          "type": [
            "string",
            "null"
          ],
          "description": "Crew that runs this task."
        },
        "orchestrator": {
          "type": "string",
          "description": "Crew credited for orchestration."
        },
        "orchestrator_model": {
          "type": "string",
          "description": "Orchestrator model when it differs from the crew."
        },
        "origin": {
          "type": "string",
          "description": "Why the task was filed."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Response field names."
        },
        "field": {
          "type": "string",
          "description": "One response field."
        },
        "request_id": {
          "type": "string",
          "description": "Retry-safe creation identity."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "request_id"
            ]
          },
          "then": {
            "required": [
              "workspace",
              "description",
              "acceptance_criteria"
            ],
            "propertyNames": {
              "enum": [
                "workspace",
                "request_id",
                "title",
                "description",
                "acceptance_criteria",
                "priority",
                "crew"
              ]
            },
            "properties": {
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "crew": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "else": {
            "required": [
              "description",
              "complexity"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_artifact",
    "description": "Read/attach artifacts; list via `orbit_task_show` (`fields: [\"artifacts\"]`).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "Operation to run, with its required fields: get (id, path); put (id, source_path).",
          "enum": [
            "get",
            "put"
          ]
        },
        "id": {
          "type": "string",
          "description": "For get: Globally unique task ID that owns the artifact; For put: task ID."
        },
        "path": {
          "type": "string",
          "description": "For get: Artifact path relative to the task artifacts directory, exactly as it appears in `orbit_task_show` with `field: \"artifacts\"`; For put: Artifact path relative to the task artifacts directory."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "source_path": {
          "type": "string",
          "description": "For put: Source file to store as a task artifact."
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_eligible",
    "description": "List backlog and proposed tasks that can be picked up now without colliding with work in flight.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "backlog",
              "proposed"
            ]
          },
          "description": "Candidate statuses."
        },
        "path": {
          "type": "string",
          "description": "Keep only candidates whose `context_files` selectors apply to this path."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum eligible tasks to return (default 50)."
        },
        "explain": {
          "type": "boolean",
          "description": "When true, also return `conflicting`."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_list",
    "description": "List tasks as {tasks, total, truncated}; rules are in the installed Orbit skill `references/task-fields.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filter by status name."
        },
        "parent_id": {
          "type": "string",
          "description": "Parent task ID."
        },
        "type": {
          "type": "string",
          "description": "Filter by task type."
        },
        "scheduled": {
          "type": "boolean",
          "description": "Keep only future schedules, soonest first."
        },
        "not_before_from": {
          "type": "string",
          "description": "Inclusive lower schedule bound as RFC 3339."
        },
        "not_before_until": {
          "type": "string",
          "description": "Inclusive upper schedule bound as RFC 3339."
        },
        "origin": {
          "type": "string",
          "description": "Filter by task origin."
        },
        "job_run_id": {
          "type": "string",
          "description": "Filter by job run ID"
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filter by tag; an array matches every listed tag."
        },
        "runs_on": {
          "type": "string",
          "description": "Filter by effective host OS."
        },
        "pilot_warnings": {
          "type": "boolean",
          "description": "Keep proposed tasks held by pilot warnings."
        },
        "ready": {
          "type": "boolean",
          "description": "Keep tasks whose dependencies are satisfied."
        },
        "path": {
          "type": "string",
          "description": "Filter by context selector path."
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of tasks to return."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Name fields, or fetch one task with `orbit_task_show`; compact rows match `orbit tool run orbit.task.list`."
        },
        "view": {
          "type": "string",
          "description": "Bounded metadata view. The only accepted value is `bounded`."
        },
        "offset": {
          "type": "integer",
          "description": "Bounded view list offset."
        },
        "search": {
          "type": "string",
          "description": "Bounded view key or title substring."
        },
        "priority": {
          "type": "string",
          "description": "Filter by priority."
        },
        "external_ref": {
          "type": "string",
          "description": "Exact external reference in system:id form."
        },
        "has_ref": {
          "type": "string",
          "description": "Keep tasks with a reference in this system."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_show",
    "description": "Fetch a task as JSON by globally unique `id`; optional `workspace` is a fail-closed filter. Use `fields` (alias `field`) for projections, or `field: \"delivery\"` for bounded commit/landing evidence. Projection, routing and delivery details: installed Orbit skill `references/task-fields.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Globally unique task ID."
        },
        "snapshot": {
          "type": "boolean",
          "description": "True returns a bounded versioned snapshot with opaque revision and available actions."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Field names to return."
        },
        "field": {
          "type": "string",
          "description": "Compatibility alias for a single field projection."
        },
        "run_id": {
          "type": "string",
          "description": "With `field: \"delivery\"` only."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "view": {
          "type": "string",
          "description": "Bounded metadata view."
        },
        "limit": {
          "type": "integer",
          "description": "Bounded detail page size"
        },
        "comments_offset": {
          "type": "integer",
          "description": "Comment offset"
        },
        "history_offset": {
          "type": "integer",
          "description": "History offset"
        },
        "artifacts_offset": {
          "type": "integer",
          "description": "Artifact metadata offset"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_update",
