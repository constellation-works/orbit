        },
        "orchestrator": {
          "type": "string",
          "description": "Orchestrator (empty clears)."
        },
        "origin": {
          "type": "string",
          "description": "operator_request | orchestrator_initiative | automation"
        },
        "context_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Selectors (replaces list; empty clears)."
        },
        "allow_missing_context": {
          "type": "boolean",
          "description": "Allow selectors for new files."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keyed response fields."
        },
        "field": {
          "type": "string",
          "description": "Single response field."
        },
        "request_id": {
          "type": "string",
          "description": "Retry-safe; selects guarded update ('verdict', 'complete'; 'comment'; or 'status' edits). Omit for an ordinary update."
        },
        "expected_revision": {
          "type": "string",
          "description": "Snapshot revision."
