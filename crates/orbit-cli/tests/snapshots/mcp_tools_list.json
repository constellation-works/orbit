  {
    "name": "orbit_task_show",
    "description": "Fetch a task as JSON by globally unique `id`; optional `workspace` is a fail-closed filter. Use `fields` (alias `field`) for projections, or `field: \"delivery\"` for bounded commit/landing evidence. Projection, routing and delivery details: installed Orbit skill `references/task-fields.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID."
        },
        "snapshot": {
          "type": "boolean",
          "description": "Versioned snapshot (needs `workspace`, no projections)."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fields (`delivery` = landing)."
        },
        "field": {
          "type": "string",
          "description": "Alias for `fields`; not with claimed pagination."
        },
        "run_id": {
          "type": "string",
          "description": "`field: \"delivery\"` run (default newest)."
        },
        "workspace": {
          "type": "string",
          "description": "From orbit_workspace_list."
        },
        "view": {
          "type": "string",
          "description": "View: only accepted value is `bounded`."
        },
        "limit": {
          "type": "integer",
          "description": "Claimed page size; not with projections."
        },
        "comments_offset": {
          "type": "integer",
          "description": "Comment offset (claimed)."
        },
        "history_offset": {
          "type": "integer",
          "description": "History offset (claimed)."
        },
        "artifacts_offset": {
          "type": "integer",
          "description": "Artifact offset (claimed)."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_update",
