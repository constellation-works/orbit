              },
              {
                "required": [
                  "expected_revision"
                ]
              },
              {
                "required": [
                  "verdict"
                ]
              },
              {
                "required": [
                  "complete"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "workspace",
