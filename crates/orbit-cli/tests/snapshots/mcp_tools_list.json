        },
        "has_ref": {
          "type": "string",
          "description": "Has ref in system."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_show",
    "description": "Fetch a task as JSON by globally unique `id`; optional `workspace` is a fail-closed filter. Use `fields` (alias `field`) for projections, or `field: \"delivery\"` for bounded commit/landing evidence. Projection, routing and delivery details: installed Orbit skill `references/task-fields-projections.md`.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Globally unique task ID."
        },
        "snapshot": {
          "type": "boolean",
          "description": "Bounded versioned snapshot; requires `workspace`, rejects `run_id`, `view`, offsets; snapshot grants no authority."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keyed response fields (`delivery`: commit/landing evidence). Rejects `snapshot`, `view`, pagination."
        },
        "field": {
          "type": "string",
          "description": "Single-field alias for `fields` (e.g. `\"artifacts\"`). Rejects `snapshot`, `view`, pagination."
        },
        "run_id": {
          "type": "string",
          "description": "Delivery run for `field: \"delivery\"` (default: newest). Rejects `snapshot`, `view`, pagination."
        },
        "workspace": {
          "type": "string",
          "description": "Workspace selector from orbit_workspace_list."
        },
        "view": {
          "type": "string",
          "description": "Bounded view; requires `workspace`, rejects `fields`, `field`, `run_id`, `snapshot`. The only accepted value is `bounded`."
        },
        "limit": {
          "type": "integer",
          "description": "Claimed read page size; not with `snapshot` or projections."
        },
        "comments_offset": {
          "type": "integer",
          "description": "Comment page offset; not with `snapshot` or projections."
        },
        "history_offset": {
          "type": "integer",
          "description": "History page offset; not with `snapshot` or projections."
        },
        "artifacts_offset": {
          "type": "integer",
          "description": "Artifact page offset; not with `snapshot` or projections."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "orbit_task_update",
    "description": "Update a task and return its JSON; rules are in the installed Orbit skill `references/task-fields-*.md` references.",
    "inputSchema": {
      "type": "object",
