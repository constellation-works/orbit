# Orbit plugin manifest (schemaVersion 2).
#
# `orbit plugin validate .` checks this file; `orbit plugin test .` runs the
# goldens under tests/conformance/ through the real protocol and records the
# Orbit version they passed on.
schemaVersion: 2
kind: Plugin
metadata:
  name: __ORBIT_PLUGIN_NS__
  version: 0.1.0
  description: Starter plugin generated by `orbit plugin scaffold`.
spec:
  requires:
    host_api: 1
    platforms: [linux, macos]

  backend:
    type: exec
    command: bin/backend.py
    timeout_ms: 30000

  # Requests, not grants: the operator answers them at
  # `orbit plugin enable __ORBIT_PLUGIN_NS__ --grant …`. This starter asks
  # for nothing, so it needs no grant to become active.
  permissions:
    network: none

  tools:
    - name: status
      description: Report this plugin's own status.
      execution_kind: read_only
      mcp_scope: workspace
      input_schema:
        type: object
        properties:
          subject:
            type: string
            description: Who the greeting is addressed to.
        additionalProperties: false
      output_schema:
        type: object
        required: [plugin, status, subject]
        properties:
          plugin: { type: string }
          status: { type: string }
          subject: { type: string }
      # `orbit __ORBIT_PLUGIN_NS__ status "<subject>"` — the promoted property
      # is still available as `--subject`.
      cli:
        positional: [subject]

  definitions:
    auto_tasks: [definitions/auto_tasks/*.yaml]

  skills: [skills/__ORBIT_PLUGIN_NS__]

  # One generic panel: the dashboard's Plugins tab renders the `status`
  # tool's object as label/value rows, with no plugin-specific JavaScript.
  web:
    panels:
      - id: status
        title: Status
        source: tool:status
        render: kv
        group: diagnostics

  tests: [tests/conformance/*.yaml]
