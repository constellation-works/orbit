+ ["table","host_aliases","host_aliases","CREATE TABLE host_aliases (\n                host_id    TEXT PRIMARY KEY,\n                machine_id TEXT NOT NULL,\n                created_at TEXT NOT NULL,\n                warning    TEXT NOT NULL,\n                CHECK (length(host_id) > 0),\n                CHECK (length(warning) > 0),\n                FOREIGN KEY(machine_id) REFERENCES hosts(machine_id)\n                    ON UPDATE RESTRICT ON DELETE RESTRICT\n            )"]
+ ["table","hosts","hosts","CREATE TABLE hosts (\n                machine_id    TEXT PRIMARY KEY,\n                host_id       TEXT NOT NULL UNIQUE,\n                labels_json   TEXT NOT NULL DEFAULT '[]',\n                status        TEXT NOT NULL CHECK (status IN ('active', 'retired')),\n                registered_at TEXT NOT NULL,\n                updated_at    TEXT NOT NULL,\n                retired_at    TEXT,\n                last_seen_at  TEXT,\n                CHECK (length(machine_id) > 0),\n                CHECK (length(host_id) > 0),\n                CHECK (json_valid(labels_json) AND json_type(labels_json) = 'array'),\n                CHECK (\n                    (status = 'active' AND retired_at IS NULL)\n                    OR (status = 'retired' AND retired_at IS NOT NULL)\n                )\n            )"]
+ ["trigger","host_alias_not_current_name_insert","host_aliases","CREATE TRIGGER host_alias_not_current_name_insert\n            BEFORE INSERT ON host_aliases\n            WHEN EXISTS (\n                SELECT 1 FROM hosts WHERE host_id = NEW.host_id\n            )\n            BEGIN\n                SELECT RAISE(ABORT, 'host alias conflicts with a current host_id');\n            END"]
+ ["trigger","host_aliases_immutable_delete","host_aliases","CREATE TRIGGER host_aliases_immutable_delete\n            BEFORE DELETE ON host_aliases\n            BEGIN\n                SELECT RAISE(ABORT, 'host aliases are permanent');\n            END"]
+ ["trigger","host_aliases_immutable_update","host_aliases","CREATE TRIGGER host_aliases_immutable_update\n            BEFORE UPDATE ON host_aliases\n            BEGIN\n                SELECT RAISE(ABORT, 'host aliases are immutable');\n            END"]
+ ["trigger","hosts_host_id_not_alias_insert","hosts","CREATE TRIGGER hosts_host_id_not_alias_insert\n            BEFORE INSERT ON hosts\n            WHEN EXISTS (\n                SELECT 1 FROM host_aliases WHERE host_id = NEW.host_id\n            )\n            BEGIN\n                SELECT RAISE(ABORT, 'host_id is reserved by a permanent alias');\n            END"]
+ ["trigger","hosts_host_id_not_alias_update","hosts","CREATE TRIGGER hosts_host_id_not_alias_update\n            BEFORE UPDATE OF host_id ON hosts\n            WHEN EXISTS (\n                SELECT 1 FROM host_aliases WHERE host_id = NEW.host_id\n            )\n            BEGIN\n                SELECT RAISE(ABORT, 'host_id is reserved by a permanent alias');\n            END"]

